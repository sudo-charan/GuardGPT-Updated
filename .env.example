# GuardGPT environment configuration example.
# Copy this file to .env and fill in real values.
# NEVER commit a real .env with secrets.

# MCP server endpoint the Agent connects to.
# The CLI (main.py --pipeline) auto-starts an MCP server if this is unreachable.
GUARDGPT_MCP_URL=http://127.0.0.1:8000/mcp

# Model downloads are disabled by default so offline validation is deterministic.
# Set to 1 only when the embedding model is not already cached locally.
# GUARDGPT_ALLOW_MODEL_DOWNLOAD=1

# Ollama generates answers and performs a separate structured output review.
# --check and --pipeline only check input and do not call Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# Optional: use a different installed model for the output reviewer.
# OLLAMA_AUDIT_MODEL=llama3
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2

# Hugging Face token (placeholder - DO NOT commit a real value).
# HF_TOKEN=
